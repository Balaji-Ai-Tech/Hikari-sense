H3_RESOLUTION=7
OFFICIAL_CORROBORATION_BOOST=0.10
RECYCLED_IMAGE_SCORE_CAP=0.40
AUTO_VERIFY_THRESHOLD=0.75
NEEDS_REVIEW_THRESHOLD=0.45

