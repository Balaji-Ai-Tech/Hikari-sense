# HIKARI SENSE — PS 26069. Never commit real secrets.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://hikari:hikari@localhost:5433/hikari
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=media
MINIO_SECURE=false
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Local HS256 when JWKS is unset. Production: set JWT_JWKS_URL (Keycloak/OIDC).
JWT_SECRET=change-me-dev-only
JWT_ALGORITHM=HS256
JWT_ISSUER=hikari-sense
JWT_AUDIENCE=hikari-sense-api
JWT_JWKS_URL=
JWT_EXPIRE_MINUTES=480

# Public weather/SACHET summary only. Keep this key on the backend, never in VITE_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20
AI_SUMMARY_MAX_REQUEST_BYTES=1024

# Gemini key is backend-only; do not add it to VITE_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20
AI_SUMMARY_MAX_REQUEST_BYTES=1024

YOUTUBE_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml
INGESTION_CONNECTORS=SRC-OPEN-METEO,SRC-SACHET,SRC-FIRMS
IMD_BASE_URL=
SACHET_BASE_URL=
FIRMS_MAP_KEY=
MLFLOW_TRACKING_URI=

PROMETHEUS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://localhost:5173,http://localhost:5174,http://127.0.0.1:8080,http://127.0.0.1:5173,http://127.0.0.1:5174

# Intelligence thresholds (blueprint starting values)
DEDUP_WINDOW_HOURS=24
